# Public Supabase settings (safe for browser identification, not authorization)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets. Never expose these through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=
# Generate a separate random value with at least 32 characters.
WORKER_SECRET=

# Optional Docker-backed coding sandbox for the separate worker host.
AUTO_SANDBOX_ENABLED=false
AUTO_SANDBOX_ROOT=/tmp/auto-sandboxes
AUTO_SANDBOX_DOCKER_IMAGE=node:22-alpine
